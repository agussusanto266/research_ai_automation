{
  "name": "research_ai_automation",
  "version": "1.0.0",
  "description": "",
  "main": "cucumber.js",
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:smoke": "node scripts/run-tests.js --tags \"@smoke\"",
    "test:sanity": "node scripts/run-tests.js --tags \"@sanity\"",
    "test:regression": "node scripts/run-tests.js --tags \"@regression\"",
    "test:login": "node scripts/run-tests.js --tags \"@login\"",
    "test:inventory": "node scripts/run-tests.js --tags \"@inventory\" --report reports/inventory-report.html",
    "test:cart": "node scripts/run-tests.js --tags \"@cart\"",
    "test:checkout-step1": "node scripts/run-tests.js --tags \"@checkout-step1\" --report reports/checkout-step1-report.html",
    "test:checkout-step2": "node scripts/run-tests.js --tags \"@checkout-step2\" --report reports/checkout-step2-report.html",
    "test:checkout-complete": "node scripts/run-tests.js --tags \"@checkout-complete\"",
    "test:product-detail": "node scripts/run-tests.js --tags \"@product-detail\"",
    "test:unit": "node --test --require ts-node/register tests/unit/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:orangehrm-login": "node scripts/run-tests.js --tags \"@orangehrm and @login\" --report reports/orangehrm-login-report.html",
    "test:orangehrm-dashboard": "node scripts/run-tests.js --tags \"@orangehrm and @dashboard\" --report reports/orangehrm-dashboard-report.html",
    "test:orangehrm-employee": "node scripts/run-tests.js --tags \"@orangehrm and @employee\" --report reports/orangehrm-employee-report.html",
    "test:orangehrm": "node scripts/run-tests.js --tags \"@orangehrm\" --report reports/orangehrm-report.html",
    "test:todo": "node scripts/run-tests.js --tags \"@todomvc\" --report reports/todo-report.html",
    "analyze:prd": "npx ts-node scripts/prd-analyzer.ts",
    "report:open": "open-cli reports/report.html",
    "allure:report": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "merge:locator-history": "node scripts/merge-locator-history.js",
    "merge:a11y": "node scripts/merge-a11y-reports.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cucumber/cucumber": "^12.8.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "allure-commandline": "^2.30.0",
    "allure-cucumberjs": "^3.2.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "open-cli": "^9.0.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
