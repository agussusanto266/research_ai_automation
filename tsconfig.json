{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "typeRoots": ["./types", "./node_modules/@types"],
    "types": ["node", "pngjs"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": [
    "features/**/*.ts",
    "step-definitions/**/*.ts",
    "support/**/*.ts",
    "pages/**/*.ts",
    "utils/**/*.ts",
    "config/**/*.ts",
    "scripts/**/*.ts",
    "types/**/*.ts",
    "test-data/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}
