# Copy this file to .env and fill in values for your environment.
# Never commit .env — it is gitignored.

# --- Target application URLs ---
BASE_URL=https://www.saucedemo.com/
ORANGEHRM_BASE_URL=https://opensource-demo.orangehrmlive.com
TODOMVC_BASE_URL=https://todomvc.com/examples/react/dist

# --- Browser control ---
# Set to "false" for local headed runs. Default is headless (true).
HEADLESS=false
# chromium | firefox | webkit — default: chromium
BROWSER=chromium

# --- Locator tuning ---
# Timeout in ms per locator candidate before self-healer tries next. Default: 1200
LOCATOR_TIMEOUT_MS=1200

# --- Parallelism ---
# Number of Cucumber workers. Default: 1 (safe baseline). Increase after suite is stable.
CUCUMBER_WORKERS=1

# --- SauceDemo credentials ---
# All SauceDemo demo users share the same password.
SAUCEDEMO_PASSWORD=secret_sauce
